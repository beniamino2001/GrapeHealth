            "exec": [
              "pm.test(\"Status 400 oltre il tetto di 500 id\", () => pm.response.to.have.status(400));\npm.test(\"Errore ben formato\", () => {\n    const body = pm.response.json();\n    pm.expect(body.errore).to.eql(\"Parametri non validi\");\n    pm.expect(body.messaggio).to.include(\"500\");\n});"
            ]
