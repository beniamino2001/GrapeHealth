          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\npm.test(\"Solo allerte attive di default\", () => {\n    const body = pm.response.json();\n    body.content.forEach(a => pm.expect(a.stato).to.eql(\"attiva\"));\n});\npm.test(\"Nessuna coppia nodo/tipo duplicata tra le allerte attive\", () => {\n    const body = pm.response.json();\n    const coppie = body.content.map(a => `${a.nodoCodice}|${a.tipo}`);\n    const uniche = new Set(coppie);\n    pm.expect(uniche.size).to.eql(coppie.length);\n});\n\nconst body = pm.response.json();\nif (body.content.length > 0) {\n    pm.environment.set(\"allertaIdConTrattamento\", body.content[0].id);\n}"
            ]
