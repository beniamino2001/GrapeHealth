    {
      "name": "/api/raccomandazioni?allertaId={{allertaIdConTrattamento}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Flag basedOnSimulatedExecution coerente\", () => {",
              "    const body = pm.response.json();",
              "    const raccomandazione = Array.isArray(body) ? body[0] : body;",
              "    if (raccomandazione.basedOnSimulatedExecution) {",
              "        pm.expect(raccomandazione.azioneEseguita).to.not.be.null;",
              "        pm.expect(raccomandazione.esitoSimulato).to.not.be.null;",
              "    } else {",
              "        pm.expect(raccomandazione.azioneEseguita).to.be.null;",
              "    }",
