        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Pre-request: forza 501 id ripetuti per superare deliberatamente il tetto\n// di MAX_ALLERTA_IDS_PER_RICHIESTA (500) e verificare il ramo di errore,\n// senza intaccare la richiesta base che esercita perAllerteAttive().\npm.request.url.query.clear();\nfor (let i = 1; i <= 501; i++) {\n    pm.request.url.query.add({ key: 'allertaIds', value: String(i) });\n}"
            ]
