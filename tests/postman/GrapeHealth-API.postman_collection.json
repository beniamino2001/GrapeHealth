      "name": "/api/raccomandazioni",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ogni raccomandazione ha l'arricchimento bibliografico\", () => {\n    const body = pm.response.json();\n    if (body.length > 0) {\n        const r = body[0];\n        pm.expect(r.descrizioneRegola).to.not.be.null;\n        pm.expect(r.fonteBibliograficaRegola).to.not.be.null;\n        pm.expect(r.azioniAlternative).to.be.an(\"array\");\n        // svernamento_oospore, infezione_secondaria e danno_radicale non hanno azioni\n        // catalogate in regola_azione (nessuna fonte bibliografica ne documenta una): un\n        // array vuoto e' il risultato corretto per queste tre regole, non un'assenza di dati.\n        if (![\"svernamento_oospore\", \"infezione_secondaria\", \"danno_radicale\"].includes(r.tipoAllerta)) {\n            pm.expect(r.azioniAlternative.length).to.be.greaterThan(0);\n        }\n    }\n});"
            ]
          }
        },
