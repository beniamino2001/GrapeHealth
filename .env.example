GIT_PATH=/percorso/assoluto/alla/cartella/del/repo/Git

RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_AMQP_PORT=5671
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_PORT_TLS=15671
RABBITMQ_HOST=localhost

POSTGRES_DB=grapehealth
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSL_MODE=verify-full
PG_SSL_ROOT_CERT=${GIT_PATH}/certs/ca.crt
PG_HOST=localhost
PG_PORT=5432

MQTT_HOST=localhost
MQTT_PORT=8883

TOMCAT_INSTANCES_DIR=/percorso/assoluto/alla/cartella/istanze/tomcat
SPRING_BOOT_LOGS_DIR=/percorso/assoluto/alla/cartella/di/log/SpringBoot

# Password del keystore/truststore Java (TLS), generata da scripts/setup-credentials.sh
# e riletta da scripts/genera-certificati-tls.sh quando crea tomcat.p12/truststore.p12:
# per questo va eseguito setup-credentials.sh prima di genera-certificati-tls.sh, non dopo.
TLS_KEYSTORE_PASSWORD=CHANGE_ME

SPRING_RABBITMQ_SSL_ENABLED=true
SPRING_RABBITMQ_SSL_TRUST_STORE_PASSWORD=${TLS_KEYSTORE_PASSWORD}
SPRING_RABBITMQ_SSL_TRUST_STORE=file:${GIT_PATH}/certs/truststore.p12
SPRING_RABBITMQ_SSL_TRUST_STORE_TYPE=PKCS12